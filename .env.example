# Public base URL, no trailing slash. MCP endpoint is ${PUBLIC_URL}/mcp
PUBLIC_URL=http://localhost:3000
PORT=3000

# Local Postgres from `bun run db:up`. In Compose: POSTGRES_HOST + POSTGRES_PASSWORD_FILE instead.
DATABASE_URL=postgres://eve:eve@localhost:5432/eve_mcp
# Used by `bun test` (each test file makes its own schema). Defaults to the local dev URL.
TEST_DATABASE_URL=postgres://eve:eve@localhost:5432/eve_mcp
# Max Postgres connections per app process (default 20).
DB_POOL_MAX=20

# EVE app from https://developers.eveonline.com (callback: ${PUBLIC_URL}/auth/eve/callback)
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=

# 32 random bytes, base64 (openssl rand -base64 32). Encrypts EVE tokens.
# Losing it = every character must re-link.
TOKEN_ENC_KEY=
# Previous key during rotation (optional)
TOKEN_ENC_KEY_OLD=

# Any secret above can come from a file instead: X_FILE=/run/secrets/x (wins over X).

# Contact for the ESI User-Agent (email or URL), required by CCP
ESI_CONTACT=
# ESI X-Compatibility-Date (YYYY-MM-DD). Check the current value in the ESI docs.
ESI_COMPAT_DATE=2026-08-18

# Comma-separated EVE character IDs whose users are admins
ADMIN_CHARACTER_IDS=
# Comma-separated origins allowed to call /mcp from a browser (empty = no browser origins)
ALLOWED_ORIGINS=
# Header your reverse proxy / Cloudflare sets with the real client IP, e.g. CF-Connecting-IP or X-Real-IP.
# Empty = use the socket address. Only set it when the app port is reachable ONLY through the
# reverse proxy; otherwise any client can send this header and dodge the rate limits.
CLIENT_IP_HEADER=

# Dev only: static bearer for /mcp before OAuth exists. Ignored when NODE_ENV=production; startup fails if PUBLIC_URL is https.
DEV_GRANT_TOKEN=
# Dev only: the user id the dev bearer acts as (default 1)
DEV_USER_ID=1

# --- docker-compose.yml (production: put these in .env next to it) ---
# Compose also reads PUBLIC_URL, EVE_CLIENT_ID, ESI_CONTACT, ADMIN_CHARACTER_IDS, CLIENT_IP_HEADER from above.
# Secrets are files in ./secrets: postgres_password, eve_client_secret, token_enc_key (chmod 600).
# Host port the reverse proxy forwards to (container port is 3000)
APP_PORT=38080
# Image name and tag (compose builds it from the Containerfile)
IMAGE=eve-mcp
IMAGE_TAG=latest
